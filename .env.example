# Copy to .env and fill from Supabase → Project Settings → API
# (Project URL, and the anon or publishable key). In Vercel, add the same two
# as Environment Variables and redeploy. The Vercel Supabase integration's
# NEXT_PUBLIC_SUPABASE_* / SUPABASE_* names work too. Never the service role key.
# Leave empty to run in local demo mode (data stays in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
